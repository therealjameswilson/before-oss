---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/Badge.astro";
import peopleData from "../../data/generated/people.json";
import type { Affiliation, PersonProfile } from "../../types";

export function getStaticPaths() {
  return (peopleData as unknown as PersonProfile[]).map((profile) => ({
    params: { id: profile.person_id },
    props: { profile },
  }));
}

const { profile } = Astro.props as { profile: PersonProfile };
const base = import.meta.env.BASE_URL;
const category = profile.personnel_category.replaceAll("_", " ");
const indexedNames = profile.source_records
  .map((row) =>
    [row.indexed_first_name, row.indexed_middle, row.indexed_last_name]
      .filter(Boolean)
      .join(" "),
  );
const issueTitle = encodeURIComponent(`Correction: ${profile.display_name}`);
const issueBody = encodeURIComponent(
  `Person ID: ${profile.person_id}\nProfile URL: ${Astro.url.href}\n\nProposed correction:\n\nSource supporting the correction:\n`,
);
const correctionUrl =
  `https://github.com/therealjameswilson/before-oss/issues/new?title=${issueTitle}&body=${issueBody}`;
const affiliationMeta = (item: Affiliation) => {
  const dates =
    item.start_date && item.end_date
      ? `${item.start_date}–${item.end_date}`
      : item.start_date
        ? `From ${item.start_date}`
        : item.end_date
          ? `Through ${item.end_date}`
          : "Dates not established";
  const location = [item.city, item.state_or_region, item.country]
    .filter(Boolean)
    .join(", ");
  return [
    dates,
    location || null,
    item.relationship_type.replaceAll("_", " "),
  ]
    .filter(Boolean)
    .join(" · ");
};
const affiliationLabel = (item: Affiliation) =>
  item.canonical_organization ??
  item.organization_name_as_found ??
  item.role_title ??
  item.occupation ??
  item.relationship_type.replaceAll("_", " ");
---

<BaseLayout
  title={profile.display_name}
  description={`Research-status profile for ${profile.display_name}, a person represented in the National Archives OSS personnel index.`}
  eyebrow="Person profile"
>
  <header class="page-hero">
    <div class="container">
      <p class="kicker">Person represented in the OSS personnel index</p>
      <h1>{profile.display_name}</h1>
      <div class="page-hero__meta">
        <Badge value={profile.identity_status} />
        <Badge value={profile.research_status} />
        <span>{category}</span>
        <span>Person ID {profile.person_id}</span>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="container profile-grid">
      <div>
        <section class="profile-section" aria-labelledby="research-status">
          <p class="kicker">Current research state</p>
          <h2 id="research-status">What the evidence currently supports</h2>
          <p class="research-note">{profile.research_status_message}</p>
          {
            profile.immediate_pre_oss_affiliations.length === 0 &&
              profile.last_civilian_pre_service.length === 0 && (
                <div class="empty-state">
                  <h3>No publishable pre-OSS affiliation is recorded yet</h3>
                  <p>
                    This is a statement about the current accessible evidence
                    and review state—not a claim that this person had no earlier
                    employer, occupation, institution, or assignment.
                  </p>
                </div>
              )
          }
        </section>

        <section class="profile-section" aria-labelledby="immediate-affiliation">
          <p class="kicker">Question A</p>
          <h2 id="immediate-affiliation">Immediate pre-OSS affiliation</h2>
          {
            profile.immediate_pre_oss_affiliations.length ? (
              profile.immediate_pre_oss_affiliations.map((item) => (
                <article class="affiliation-card">
                  <h3>
                    {affiliationLabel(item)}
                  </h3>
                  <p>{item.role_title ?? item.occupation ?? item.relationship_type}</p>
                  <p class="citation-meta">{affiliationMeta(item)}</p>
                  <p>
                    <Badge value={item.claim_confidence} />
                    {" "}
                    <Badge value={item.temporal_basis} />
                  </p>
                </article>
              ))
            ) : (
              <p>No reviewed claim currently meets the publication threshold.</p>
            )
          }
        </section>

        <section class="profile-section" aria-labelledby="civilian-employer">
          <p class="kicker">Question B</p>
          <h2 id="civilian-employer">Last civilian employer before service</h2>
          {
            profile.last_civilian_pre_service.length ? (
              profile.last_civilian_pre_service.map((item) => (
                <article class="affiliation-card">
                  <h3>
                    {affiliationLabel(item)}
                  </h3>
                  <p>{item.role_title ?? item.occupation ?? "Employment"}</p>
                  <p class="citation-meta">{affiliationMeta(item)}</p>
                  <p>
                    <Badge value={item.claim_confidence} />
                    {" "}
                    <Badge value={item.temporal_basis} />
                  </p>
                </article>
              ))
            ) : (
              <p>
                {
                  profile.research_status === "verified_employer_found" ||
                  profile.research_status ===
                    "documented_prewar_employer_found" ||
                  profile.research_status ===
                    "no_reliable_result_after_protocol" ||
                  profile.research_status === "requires_archival_review" ||
                  profile.research_status === "completed"
                    ? "No reliable pre-OSS employer has yet been identified in the accessible sources reviewed."
                    : profile.research_attempt_count > 0
                      ? "No reviewed claim currently meets the publication threshold."
                      : "The last-civilian-employer question has not yet been researched for this record."
                }
              </p>
            )
          }
        </section>

        {
          profile.other_pre_oss_affiliations.length > 0 && (
            <section class="profile-section" aria-labelledby="earlier-affiliations">
              <p class="kicker">Other documented work</p>
              <h2 id="earlier-affiliations">Earlier pre-OSS affiliations</h2>
              {profile.other_pre_oss_affiliations.map((item) => (
                <article class="affiliation-card">
                  <h3>
                    {affiliationLabel(item)}
                  </h3>
                  <p>{item.role_title ?? item.occupation}</p>
                  <p class="citation-meta">{affiliationMeta(item)}</p>
                  <Badge value={item.claim_confidence} />
                </article>
              ))}
            </section>
          )
        }

        <section class="profile-section" aria-labelledby="index-records">
          <p class="kicker">NARA source rows</p>
          <h2 id="index-records">How the person appears in the index</h2>
          <p>
            Each printed row remains separate. Masked serial suffixes assist
            orientation without publishing full service numbers.
          </p>
          {
            profile.source_records.map((row, index) => (
              <article class="index-record">
                <h3>Index row {index + 1}</h3>
                <dl>
                  <div>
                    <dt>Name as indexed</dt>
                    <dd>
                      {[row.indexed_last_name, row.indexed_first_name, row.indexed_middle]
                        .filter(Boolean)
                        .join(" | ")}
                    </dd>
                  </div>
                  <div>
                    <dt>Rank or grade</dt>
                    <dd>{row.rank_as_indexed ?? "Not printed"}</dd>
                  </div>
                  <div>
                    <dt>Serial</dt>
                    <dd>{row.serial_masked ?? "Not printed"}</dd>
                  </div>
                  <div>
                    <dt>Box</dt>
                    <dd>{row.box ?? "Not printed"}</dd>
                  </div>
                  <div>
                    <dt>Notes</dt>
                    <dd>{row.notes_as_indexed ?? "None printed"}</dd>
                  </div>
                  <div>
                    <dt>Archive location</dt>
                    <dd>{row.archive_location ?? "Not printed"}</dd>
                  </div>
                  <div>
                    <dt>PDF page</dt>
                    <dd><a href={row.pdf_url}>Page {row.pdf_page}</a></dd>
                  </div>
                  <div>
                    <dt>Source-record ID</dt>
                    <dd>{row.source_record_id}</dd>
                  </div>
                </dl>
              </article>
            ))
          }
        </section>

        {
          profile.claims.length > 0 && (
            <section class="profile-section" aria-labelledby="evidence">
              <p class="kicker">Claim-level evidence</p>
              <h2 id="evidence">Evidence and citations</h2>
              {profile.claims.map((claim) => (
                <article class="affiliation-card">
                  <h3>{claim.claim_text}</h3>
                  <p>{claim.evidence_paraphrase}</p>
                  {claim.evidence_excerpt && (
                    <blockquote>“{claim.evidence_excerpt}”</blockquote>
                  )}
                  <p>
                    <Badge value={claim.claim_confidence} />
                    {" "}
                    <Badge value={claim.source_quality} />
                  </p>
                  <h4>Sources for this claim</h4>
                  <ol class="citation-list">
                    {claim.sources.map((link) => {
                      const source = link.source;
                      const locator = link.locator_override ?? source.locator;
                      return (
                        <li>
                          <p>
                            {source.stable_url ? (
                              <a href={source.stable_url}>{source.title}</a>
                            ) : (
                              <strong>{source.title}</strong>
                            )}
                            {source.author_creator && ` — ${source.author_creator}`}
                            {`. ${source.repository_publisher}.`}
                            {source.publication_record_date &&
                              ` ${source.publication_record_date}.`}
                          </p>
                          <p class="citation-meta">
                            {source.archival_identifier &&
                              `Archival identifier: ${source.archival_identifier}. `}
                            {source.document_number &&
                              `Document: ${source.document_number}. `}
                            {locator && `Locator: ${locator}. `}
                            {`Accessed ${source.access_date}.`}
                          </p>
                          {link.excerpt_override && (
                            <blockquote>“{link.excerpt_override}”</blockquote>
                          )}
                          <p class="citation-meta">
                            Support: {link.support_type.replaceAll("_", " ")}.
                          </p>
                        </li>
                      );
                    })}
                  </ol>
                </article>
              ))}
            </section>
          )
        }
      </div>

      <aside class="profile-aside" aria-label="Profile facts and archival status">
        <h2>Profile facts</h2>
        <dl>
          <div>
            <dt>Indexed form</dt>
            <dd>{indexedNames.join("; ")}</dd>
          </div>
          <div>
            <dt>Normalized form</dt>
            <dd>{profile.display_name}</dd>
          </div>
          <div>
            <dt>Documented variants</dt>
            <dd>
              {profile.name_variants.length
                ? profile.name_variants.join("; ")
                : "None documented beyond the indexed form"}
            </dd>
          </div>
          <div>
            <dt>Personnel category</dt>
            <dd>{category}</dd>
          </div>
          <div>
            <dt>Commissioned officer</dt>
            <dd><Badge value={profile.commissioned_officer} /></dd>
          </div>
          <div>
            <dt>Allied or foreign note</dt>
            <dd><Badge value={profile.allied_or_foreign_personnel} /></dd>
          </div>
          <div>
            <dt>Identity status</dt>
            <dd><Badge value={profile.identity_status} /></dd>
          </div>
          <div>
            <dt>Duplicate group</dt>
            <dd>{profile.possible_duplicate_group ?? "None currently flagged"}</dd>
          </div>
          <div>
            <dt>Personnel file indexed</dt>
            <dd><Badge value={profile.archival_file.indexed} /></dd>
          </div>
          <div>
            <dt>Personnel file digitized</dt>
            <dd><Badge value={profile.archival_file.digitized} /></dd>
          </div>
          <div>
            <dt>Personnel file reviewed</dt>
            <dd><Badge value={profile.archival_file.reviewed} /></dd>
          </div>
          <div>
            <dt>Archive box</dt>
            <dd>{profile.archival_file.box ?? "Not recorded"}</dd>
          </div>
          <div>
            <dt>Archive location</dt>
            <dd>{profile.archival_file.location ?? "Not recorded"}</dd>
          </div>
          <div>
            <dt>Archival-review priority</dt>
            <dd><Badge value={profile.archival_file.review_priority} /></dd>
          </div>
          {
            profile.archival_file.nara_catalog_id && (
              <div>
                <dt>NARA Catalog</dt>
                <dd>
                  <a
                    href={`https://catalog.archives.gov/id/${profile.archival_file.nara_catalog_id}`}
                  >
                    NAID {profile.archival_file.nara_catalog_id}
                  </a>
                </dd>
              </div>
            )
          }
        </dl>
        <p>
          <a class="button button--ghost" href={correctionUrl}>
            Report a correction
          </a>
        </p>
        <p><a href={`${base}people/`}>Return to the personnel directory</a></p>
      </aside>
    </div>
  </section>
</BaseLayout>
