---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/Badge.astro";
import organizationData from "../../data/generated/organizations.json";
import type { Organization } from "../../types";

export function getStaticPaths() {
  return (organizationData as unknown as Organization[]).map((organization) => ({
    params: { id: organization.organization_id },
    props: { organization },
  }));
}

const { organization } = Astro.props as { organization: Organization };
const base = import.meta.env.BASE_URL;

function affiliationDates(
  startDate: string | null,
  endDate: string | null,
): string {
  if (startDate && endDate) return `${startDate}–${endDate}`;
  if (startDate) return `From ${startDate}`;
  if (endDate) return `Through ${endDate}`;
  return "Dates not established";
}
---

<BaseLayout
  title={organization.canonical_name}
  description={`Historical organization profile for ${organization.canonical_name} in the Before OSS research dataset.`}
  eyebrow="Organization profile"
>
  <header class="page-hero">
    <div class="container">
      <p class="kicker">
        {organization.sector?.replaceAll("_", " ") ?? "Sector under review"}
      </p>
      <h1>{organization.canonical_name}</h1>
      <div class="page-hero__meta">
        <span>{organization.organization_type ?? "Organization type under review"}</span>
        <span>
          {Number(organization.documented_person_count).toLocaleString("en-US")}
          {" "}linked person entities
        </span>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="narrow prose">
        <h2>Historical identity</h2>
        <dl class="profile-facts">
          <div>
            <dt>Canonical name</dt>
            <dd>{organization.canonical_name}</dd>
          </div>
          <div>
            <dt>Name as historically documented</dt>
            <dd>{organization.historical_name ?? "No separate historical form recorded"}</dd>
          </div>
          <div>
            <dt>Aliases</dt>
            <dd>{organization.aliases_json ?? "[]"}</dd>
          </div>
          <div>
            <dt>Location</dt>
            <dd>
              {[organization.city, organization.state_or_region, organization.country]
                .filter(Boolean)
                .join(", ") || "Not recorded"}
            </dd>
          </div>
          <div>
            <dt>Active dates</dt>
            <dd>{organization.active_dates ?? "Not recorded"}</dd>
          </div>
          <div>
            <dt>Organization ID</dt>
            <dd>{organization.organization_id}</dd>
          </div>
        </dl>

        <h2>Normalization notes</h2>
        <p>
          {organization.normalization_notes ??
            "No additional normalization note is currently published."}
        </p>
        <p class="chart-note">
          Linked-person counts include unique person entities with confirmed,
          high-, or visibly qualified medium-confidence published claims. They
          do not measure the complete OSS workforce.
        </p>

        <section class="profile-section" aria-labelledby="documented-personnel">
          <h2 id="documented-personnel">Documented OSS personnel</h2>
          <p>
            Each link below reflects a reviewed, published affiliation claim.
            Relationship types remain distinct: military or government service,
            study, and professional affiliations are not recast as employment.
          </p>
          {
            organization.linked_people.map((person) => (
              <article class="affiliation-card">
                <h3>
                  <a href={`${base}people/${person.person_id}/`}>
                    {person.display_name}
                  </a>
                </h3>
                <p>
                  <Badge value={person.identity_status} />
                  {" "}
                  <Badge value={person.research_status} />
                </p>
                {person.affiliations.map((affiliation) => (
                  <div class="organization-affiliation">
                    <p>
                      <strong>
                        {affiliation.role_title ??
                          affiliation.occupation ??
                          affiliation.relationship_type.replaceAll("_", " ")}
                      </strong>
                    </p>
                    <p class="citation-meta">
                      {affiliation.relationship_type.replaceAll("_", " ")}
                      {" · "}
                      {affiliationDates(
                        affiliation.start_date,
                        affiliation.end_date,
                      )}
                      {" · "}
                      {affiliation.immediate_pre_oss
                        ? "immediate pre-OSS affiliation"
                        : affiliation.last_civilian_pre_service
                          ? "last civilian employer before service"
                          : "other documented pre-OSS affiliation"}
                    </p>
                    <p>
                      <Badge value={affiliation.claim_confidence} />
                      {" "}
                      <Badge value={affiliation.temporal_basis} />
                    </p>
                  </div>
                ))}
                {person.claims.map((claim) => (
                  <div class="organization-claim">
                    <h4>{claim.claim_text}</h4>
                    <p>{claim.evidence_paraphrase}</p>
                    <ol class="citation-list">
                      {claim.sources.map((link) => {
                        const source = link.source;
                        const locator = link.locator_override ?? source.locator;
                        return (
                          <li>
                            <p>
                              {source.stable_url ? (
                                <a href={source.stable_url}>{source.title}</a>
                              ) : (
                                <strong>{source.title}</strong>
                              )}
                              {source.author_creator &&
                                ` — ${source.author_creator}`}
                              {`. ${source.repository_publisher}.`}
                              {source.publication_record_date &&
                                ` ${source.publication_record_date}.`}
                            </p>
                            <p class="citation-meta">
                              {source.archival_identifier &&
                                `Archival identifier: ${source.archival_identifier}. `}
                              {source.document_number &&
                                `Document: ${source.document_number}. `}
                              {locator && `Locator: ${locator}. `}
                              {`Accessed ${source.access_date}.`}
                            </p>
                          </li>
                        );
                      })}
                    </ol>
                  </div>
                ))}
              </article>
            ))
          }
        </section>
    </div>
  </section>
</BaseLayout>
