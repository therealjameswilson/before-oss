---
import BaseLayout from "../../layouts/BaseLayout.astro";
import stats from "../../data/generated/stats.json";
import analytics from "../../data/generated/analytics.json";
import people from "../../data/generated/people.json";
import ResearchChart from "../../components/ResearchChart.astro";
const names = new Map(people.map(p => [p.person_id, p.display_name]));

const categories = Object.entries(stats.personnel_category_counts)
  .sort((left, right) => Number(right[1]) - Number(left[1]));
const maxCategory = Math.max(...categories.map(([, count]) => Number(count)), 1);
const researchStatuses = Object.entries(stats.research_status_counts)
  .sort((left, right) => Number(right[1]) - Number(left[1]));
const identityStatuses = Object.entries(stats.identity_status_counts)
  .sort((left, right) => Number(right[1]) - Number(left[1]));
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Analysis"
  description="Confidence-aware coverage, personnel-category, and research-status analysis of the current Before OSS dataset."
  eyebrow="Analysis"
>
  <header class="page-hero">
    <div class="container">
      <h1>What the current dataset can—and cannot—show</h1>
      <p class="lede">
        Extraction is complete. Employer research is not. Every visualization
        states its denominator, unit of count, confidence rule, and coverage date.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <p class="kicker">Index composition</p>
      <h2>Personnel categories in the printed index</h2>
      <p class="chart-note">
        Denominator: {Number(stats.person_entities).toLocaleString("en-US")} cautious
        person entities. These categories are derived from printed rank or grade,
        with unfamiliar abbreviations left indeterminate. Updated {stats.generated_at}.
      </p>
      <div class="chart" role="img" aria-label="Bar chart of personnel categories">
        {
          categories.map(([label, count]) => (
            <div class="chart-row">
              <span>{label.replaceAll("_", " ")}</span>
              <span class="chart-row__track" aria-hidden="true">
                <span
                  class="chart-row__bar"
                  style={`width:${(100 * Number(count)) / maxCategory}%`}
                ></span>
              </span>
              <strong>{Number(count).toLocaleString("en-US")}</strong>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--paper-light">
    <div class="container">
      <p class="kicker">Research state</p>
      <h2>Coverage remains visibly incomplete</h2>
      <div class="stat-grid stat-grid--three">
        <article class="stat-card stat-card--rust">
          <p class="stat-card__label">Research attempted</p>
          <p class="stat-card__value">{stats.research_attempt_percent.toFixed(4)}%</p>
          <p class="stat-card__detail">
            {Number(stats.research_attempted_people).toLocaleString("en-US")} of
            {" "}{Number(stats.person_entities).toLocaleString("en-US")} entities
            have a non-planned live attempt.
          </p>
        </article>
        <article class="stat-card stat-card--olive">
          <p class="stat-card__label">Verified employer found</p>
          <p class="stat-card__value">{stats.verified_employer_percent.toFixed(4)}%</p>
          <p class="stat-card__detail">
            {Number(stats.verified_employer_people).toLocaleString("en-US")} people
            have confirmed/high published employment or self-employment evidence.
            The broader verified-affiliation measure is{" "}
            {Number(stats.verified_affiliation_people).toLocaleString("en-US")}.
          </p>
        </article>
        <article class="stat-card stat-card--muted">
          <p class="stat-card__label">Archival review assessed</p>
          <p class="stat-card__value">{stats.archival_review_percent.toFixed(4)}%</p>
          <p class="stat-card__detail">
            File-access status or pull priority has been individually assessed.
          </p>
        </article>
      </div>

      <div class="analysis-grid">
        <div>
          <h3>Research statuses</h3>
          <ul class="count-list">
            {researchStatuses.map(([label, count]) => (
              <li>
                <span>{label.replaceAll("_", " ")}</span>
                <strong>{Number(count).toLocaleString("en-US")}</strong>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Identity statuses</h3>
          <ul class="count-list">
            {identityStatuses.map(([label, count]) => (
              <li>
                <span>{label.replaceAll("_", " ")}</span>
                <strong>{Number(count).toLocaleString("en-US")}</strong>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="kicker">Employer analytics</p>
      <h2>The pathways documented so far</h2>
      <p class="lede">
        These are findings within a partially researched index, not a representative
        portrait of the full OSS workforce. Each chart has its own denominator;
        open its counted-person list to follow the profile and claim-level citations.
      </p>
      <p><a href={`${base}data/analytics.json`} download>Download the complete chart data and counted-person identifiers</a></p>
      {analytics.charts.map(chart => <ResearchChart chart={chart} context={analytics} names={names} />)}
      <div class="analysis-grid">
        <section aria-labelledby="claim-confidence-counts">
          <h3 id="claim-confidence-counts">Confidence of publicly visible claims</h3>
          <p class="chart-note">Denominator: {stats.published_claims} claim records, not people or source rows.
            All public confidence levels, including qualified and conflicting claims, are shown;
            withheld speculative candidates are excluded. Research coverage: {stats.research_attempt_percent.toFixed(4)}%.
            Updated {stats.generated_at}.</p>
          <ul class="count-list">{Object.entries(analytics.public_claim_confidence).map(([label, count]) =>
            <li><span>{label}</span><strong>{count}</strong></li>)}</ul>
        </section>
        <section aria-labelledby="archival-priority-counts">
          <h3 id="archival-priority-counts">Archival review priorities</h3>
          <p class="chart-note">Denominator: {stats.person_entities.toLocaleString("en-US")} unique person entities.
            All confidence and research statuses, including unassessed files; not source rows.
            Research coverage: {stats.research_attempt_percent.toFixed(4)}%. Updated {stats.generated_at}.</p>
          <ul class="count-list">{Object.entries(analytics.archival_priorities).map(([label, count]) =>
            <li><span>{label.replaceAll("_", " ")}</span><strong>{count.toLocaleString("en-US")}</strong></li>)}</ul>
        </section>
      </div>
      <p><a href={`${base}methodology/`}>Read the analytic inclusion rules</a></p>
    </div>
  </section>
</BaseLayout>
